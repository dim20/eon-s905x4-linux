# Option D: intentional config changes on top of meson64_a64_P_defconfig
#
# Applied with:
#   ./scripts/config --file out/.config --enable AMLOGIC_MEDIA_VIDEOCAPTURE
#   ./scripts/config --file out/.config --enable DRM_MESON_EMULATE_FBDEV
#   ./scripts/config --file out/.config --enable FRAMEBUFFER_CONSOLE
#   ./scripts/config --file out/.config --enable FRAMEBUFFER_CONSOLE_DETECT_PRIMARY
#   ./scripts/config --file out/.config --enable FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER
#
# ---------------------------------------------------------------------------
# CONFIG_AMLOGIC_MEDIA_VIDEOCAPTURE
#
# WHY: drivers/amlogic/media/video_sink/video_hw.c uses vd_layer[].capture_use_cnt,
# .capture_frame_req and CAPTURE_STATE_* unconditionally, but all three are inside
# #ifdef CONFIG_AMLOGIC_MEDIA_VIDEOCAPTURE in video_priv.h (lines 519, 628). The
# defconfig does not enable it, so the tree does not compile as shipped. Enabling
# the option is the correct fix (the .c is right; the defconfig is incomplete).
#
# Verified to survive syncconfig.
CONFIG_AMLOGIC_MEDIA_VIDEOCAPTURE=y
#
# ---------------------------------------------------------------------------
# CONFIG_DRM_MESON_EMULATE_FBDEV
#
# WHY: this is what makes the display usable.
#
# The vendor's DRM driver has a complete framebuffer emulation
# (drivers/amlogic/drm/meson_fbdev.c) which creates a /dev/fbN for the
# PRIMARY plane and one per OSD plane, using drm_fb_helper. It is all present
# and correct, but the whole thing sits behind this option:
#
#     drivers/amlogic/drm/meson_drv.c:355
#         #ifdef CONFIG_DRM_MESON_EMULATE_FBDEV
#                 ret = am_meson_drm_fbdev_init(drm);
#         #endif
#
# Without it there is no DRM framebuffer at all — only the four vendor OSD
# overlays, which have no fix_screeninfo.visual.weight and so are rejected
# by X's fbdev driver:
#
#     (EE) FBDEV(0): Weight given (000) is inconsistent with the depth (32)
#
# The DTB already provides everything it needs (fbdev_sizes,
# primary_plane_index, status=okay) and meson_drv.c already sets
# drm->irq_enabled = true for the vblank path. Nothing else is required.
CONFIG_DRM_MESON_EMULATE_FBDEV=y
#
# ---------------------------------------------------------------------------
# CONFIG_FRAMEBUFFER_CONSOLE and CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY
#
# WHY: so there is a text console on the HDMI output, not only on the
# serial port.
#
# This kernel has CONFIG_VT_CONSOLE=y but no framebuffer console, so
# /proc/consoles lists only ttyS0 and agetty on tty1 has a VT that nothing
# scans out to the display. Enabling fbcon binds a VT to the framebuffer.
#
# The option is named FRAMEBUFFER_CONSOLE, not FB_CONSOLE, and the
# implementation lives at drivers/video/fbdev/core/fbcon.c in this tree.
#
# DETECT_PRIMARY makes fbcon pick the PRIMARY display device, which is the
# one the HDMI transmitter actually scans out (the vendor OSD overlays are a
# different plane).
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
#
# ---------------------------------------------------------------------------
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER
#
# WHY: fbcon must not take the console over at the moment the framebuffers
# register.
#
# The vendor's DRM framebuffer is created during probe, before the HDMI
# pipeline is up, and taking the console over at that point programs a
# mode set the vendor's atomic-commit path cannot satisfy - it waits for
# a vblank that never arrives.
#
# With the option on, fbcon registers and waits, and the take-over
# happens later, when the display pipeline is live.
#
# WHY IT NEEDED A FIX (patches/0010)
#
# The take-over is deferred to a workqueue, and the workqueue is
# scheduled by a notifier that fires when the dummy console is written
# to. The dummy console is only the preferred one until a real console
# registers, so that notifier fires early - and if the work runs before
# the DRM's framebuffer has registered, it finds nothing to take over
# and nothing ever reschedules it. The console then never takes the
# display over, and /proc/consoles lists only the serial port.
#
# patches/0010 reschedules the work when a framebuffer registers, so it
# always runs after the framebuffer it is meant to take over.
#
# NOTE: on this architecture fb_is_primary_device() returns 0, so
# DETECT_PRIMARY on its own does nothing; the framebuffer console is bound
# to the right device because the vendor driver marks its primary-plane
# framebuffer FBINFO_PRIMARY - see patches/0003 and patches/0009.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
