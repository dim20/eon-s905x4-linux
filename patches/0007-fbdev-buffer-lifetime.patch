+/*
+ * am_meson_fbdev_unmap_fb_gem - unmap the framebuffer's buffer
+ * @info: fb_info structure
+ *
+ * The buffer itself is NOT freed here. It belongs to the framebuffer,
+ * not to the open file - see am_meson_fbdev_release() for why that
+ * matters.
+ */
+static void am_meson_fbdev_unmap_fb_gem(struct fb_info *info)
+{
+	struct drm_fb_helper *helper = info->par;
+	struct meson_drm_fbdev *fbdev;
+	struct am_meson_gem_object *meson_gem;
+
+	if (!helper) {
+		DRM_ERROR("fb helper is NULL!\n");
+		return;
+	}
+
+	fbdev = container_of(helper, struct meson_drm_fbdev, base);
+	if (!fbdev || !fbdev->fb_gem)
+		return;
+
+	meson_gem = container_of(fbdev->fb_gem, struct am_meson_gem_object, base);
+
+	dma_buf_put(meson_gem->dmabuf);
+	ion_buffer_kmap_put(meson_gem->ionbuffer);
+
+	info->screen_base = NULL;
+}
+
+/*
+ * am_meson_fbdev_free_fb_gem - free the framebuffer's buffer
+ * @info: fb_info structure
+ *
+ * Only safe where the plane cannot be reading the buffer any more.
+ * Everywhere else, unmap it and keep it.
+ */
 static void am_meson_fbdev_free_fb_gem(struct fb_info *info)
 {
 	struct drm_fb_helper *helper = info->par;
 	struct meson_drm_fbdev *fbdev;
 	struct drm_framebuffer *fb;
 	struct am_meson_fb *meson_fb;
+	struct am_meson_gem_object *meson_gem;
 
 	if (!helper) {
 		DRM_ERROR("fb helper is NULL!\n");
@@ -88,37 +133,65 @@
 	}
 
 	fbdev = container_of(helper, struct meson_drm_fbdev, base);
-	if (fbdev && fbdev->fb_gem) {
-		struct drm_gem_object *gem_obj = fbdev->fb_gem;
-		struct am_meson_gem_object *meson_gem = container_of(gem_obj,
-					struct am_meson_gem_object, base);
-
-		dma_buf_put(meson_gem->dmabuf);
-		ion_buffer_kmap_put(meson_gem->ionbuffer);
-
-		if (meson_gem->ionbuffer->kmap_cnt)
-			return;
-
-		info->screen_base = NULL;
-
-		am_meson_gem_object_free(fbdev->fb_gem);
-		fbdev->fb_gem = NULL;
-
-		fb = helper->fb;
-		if (fb) {
-			meson_fb = container_of(fb, struct am_meson_fb, base);
-			if (meson_fb)
-				meson_fb->bufp[0] = NULL;
-			else
-				DRM_ERROR("meson_fb is NULL!\n");
-		} else {
-			DRM_ERROR("drm framebuffer is NULL!\n");
-		}
-
-		DRM_DEBUG("free memory done\n");
+	if (!fbdev || !fbdev->fb_gem) {
+		DRM_DEBUG("memory already free before\n");
+		return;
+	}
+
+	meson_gem = container_of(fbdev->fb_gem, struct am_meson_gem_object, base);
+
+	am_meson_fbdev_unmap_fb_gem(info);
+
+	/* Somebody else still has it mapped: leave it alone. */
+	if (meson_gem->ionbuffer->kmap_cnt)
+		return;
+
+	am_meson_gem_object_free(fbdev->fb_gem);
+	fbdev->fb_gem = NULL;
+
+	fb = helper->fb;
+	if (fb) {
+		meson_fb = container_of(fb, struct am_meson_fb, base);
+		if (meson_fb)
+			meson_fb->bufp[0] = NULL;
+		else
+			DRM_ERROR("meson_fb is NULL!\n");
 	} else {
-		DRM_DEBUG("memory already free before\n");
-	}
+		DRM_ERROR("drm framebuffer is NULL!\n");
+	}
+
+	DRM_DEBUG("free memory done\n");
+}
+
+/*
+ * am_meson_fbdev_retire_fb_gem - keep the buffer the plane may still be
+ *	reading, instead of freeing it
+ * @fbdev: the fbdev
+ * @info: fb_info structure
+ *
+ * The plane's address is only recomputed on a commit, so a buffer that
+ * is being replaced may still be the one the display is reading. It is
+ * kept until the framebuffer goes away.
+ */
+static void am_meson_fbdev_retire_fb_gem(struct meson_drm_fbdev *fbdev,
+					 struct fb_info *info)
+{
+	if (!fbdev->fb_gem)
+		return;
+
+	/*
+	 * If there is already a spare, it is at least one mode set old,
+	 * so the plane has moved off it by now.
+	 */
+	if (fbdev->spare_gem) {
+		am_meson_gem_object_free(fbdev->spare_gem);
+		fbdev->spare_gem = NULL;
+	}
+
+	am_meson_fbdev_unmap_fb_gem(info);
+
+	fbdev->spare_gem = fbdev->fb_gem;
+	fbdev->fb_gem = NULL;
 }
 
 static int am_meson_fbdev_open(struct fb_info *info, int arg)
@@ -135,7 +208,23 @@
 
 static int am_meson_fbdev_release(struct fb_info *info, int arg)
 {
-	am_meson_fbdev_free_fb_gem(info);
+	/*
+	 * Unmap the buffer, but do NOT free it.
+	 *
+	 * The buffer belongs to the framebuffer, not to the open file:
+	 *
+	 *   - the plane may still be reading it, and freeing it left the
+	 *     display reading memory that had been handed back to the
+	 *     allocator;
+	 *   - the next open has to find it at the SAME address, because
+	 *     the plane's address is only recomputed on a commit. A new
+	 *     buffer, probably at a different address, left the display
+	 *     showing the OLD one - a stale frame - while the new client
+	 *     drew into the new one.
+	 *
+	 * It is freed when the framebuffer goes away.
+	 */
+	am_meson_fbdev_unmap_fb_gem(info);
 	return 0;
 }
 
@@ -366,8 +455,13 @@
 		drm_fb_helper_fill_info(info, fb_helper, &sizes);
 
