+		 * references twice.
+		 */
+		if (fbinfo)
+			am_meson_fbdev_free_fb_gem(fbinfo);
+		if (fbdev->spare_gem) {
+			am_meson_gem_object_free(fbdev->spare_gem);
+			fbdev->spare_gem = NULL;
+		}
+
 		drm_fb_helper_unregister_fbi(helper);
 		drm_fb_helper_fini(helper);
 		if (helper->fb)
