 		am_meson_fbdev_free_fb_gem(fb_info);
 		DRM_INFO("fb mem is freed !\n");
 	}
@@ -848,6 +948,24 @@
 			}
 		}
 
+		/*
+		 * The framebuffer's buffer goes away with the
+		 * framebuffer, and not before: the plane may still be
