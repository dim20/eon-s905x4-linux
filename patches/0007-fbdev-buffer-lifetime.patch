 		}
 
@@ -671,6 +765,12 @@
 	struct fb_info *fb_info = dev_get_drvdata(device);
 
 	if (strncmp("1", buf, 1) == 0) {
+		/*
+		 * The plane may still be reading this buffer, so take it
+		 * off the display before the memory goes back to the
+		 * allocator.
