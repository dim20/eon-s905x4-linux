+		 *     fPtr->fboff = (unsigned long) fPtr->fix.smem_start
+		 *                   & ~PAGE_MASK;
+		 *     fPtr->fbstart = fPtr->fbmem + fPtr->fboff;
+		 *
+		 * so with the physical address in there, the X server's
+		 * screen pixmap landed 0x77ff0000 bytes - two gigabytes -
+		 * past the start of the mapping, and everything it drew
