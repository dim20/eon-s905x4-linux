#!/bin/sh
# prerm - the package is being removed.
#
# The kernel on the boot partition is NOT touched. Removing the package
# removes the copy under /usr/lib/sc2-kernel; the one on the boot
# partition stays, because that is the one the box boots, and deleting
# it would leave the box unable to boot.
#
# The archived kernels are also left alone. They are the rollback, and
# they are not the package's files - they live in the archive
# directory, which this package does not own.

set -e

printf 'sc2-kernel: the kernel on the boot partition has been left alone\n'
printf 'sc2-kernel: removing this package does not stop the box from booting\n'

exit 0
