[Unit]
Description=Build the font cache
Documentation=man:fc-cache(1)
# fontconfig builds its cache the first time something asks it for a
# font, and until it is built it answers with a two-pixel default. A
# program that starts in that window gets that font, and its text is
# invisible: an xterm's window came out 173x62 pixels for 80x24
# characters, and the terminal was a black box. The second terminal was
# fine, because by then the cache existed.
#
# So build the cache before anything graphical starts. It takes a few
# seconds once, and then every program gets real fonts.
Before=lightdm.service
Before=display-manager.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/fc-cache -f
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
