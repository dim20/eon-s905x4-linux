[Unit]
Description=Enable the HDMI display output
Documentation=man:modetest(1)
# Runs EARLY, and on purpose.
#
# This unit is what puts the first picture on the screen, so it has to run
# before the boot messages have scrolled off. Ordered after multi-user it did
# not: multi-user waits for the root device unit to settle, which on a USB
# stick is ~17 s, and the display came up long after the interesting part of
# the boot had gone. So it is ordered into sysinit, with no default
# dependencies (those would order it after sysinit.target and create a cycle).
#
# The ordering alone is not enough: started this early it can beat udev, so
# enable-hdmi.sh WAITS for /dev/dri/card0 and retries the mode set. Without
# that, a run that lost the race would leave the screen black for the whole
# boot - the failure mode the old ConditionPathExists had.
#
# There is deliberately NO ConditionPathExists on the connector any more, and
# no dependency on dev-dri-card0.device: that device unit never settles on
# this box (udev does not finish with the DRM device), so depending on it
# leaves multi-user.target waiting forever. The script waits instead.
DefaultDependencies=no
After=systemd-udevd.service systemd-udev-trigger.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/root/enable-hdmi.sh
# Never let a display problem stop the box from reaching multi-user.
SuccessExitStatus=0
TimeoutStartSec=30

[Install]
WantedBy=sysinit.target
