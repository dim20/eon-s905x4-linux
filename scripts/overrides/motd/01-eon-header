#!/bin/sh
# 01-eon-header — the banner at the top of the login message.
#
# WHY THIS IS NOT THE VENDOR'S VERSION
#
# The vendor shipped a script here that prints an Ubuntu-style ASCII
# banner, with terminal escape sequences embedded in it (terminfo
# capabilities such as \e{lightred}, written out literally because the
# script used `echo` without -e in some paths).
#
# The framebuffer console on the HDMI output does not interpret escape
# sequences - it is a plain text console, not a terminal emulator - so
# that banner arrived on the TV as literal "\e[0;91m" text. The serial
# console and SSH rendered it correctly, which is why the problem only
# showed up on the television.
#
# Everything below is plain ASCII, so it renders identically on the TV,
# on the serial console and over SSH. The identity comes from
# /etc/eon-release; Debian's own /etc/os-release is left alone and still
# truthfully says Debian.

[ -r /etc/eon-release ] && . /etc/eon-release

echo "  ${NAME:-EON Linux} - ${BASE:-Debian}"
echo "  eon-s905x4-linux - Debian for the EON SDSTB02 (Amlogic S905X4 / SC2)"
echo
